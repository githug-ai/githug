{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["src/worker.ts", "src/core.ts", "src/gateway-api.ts", "src/app.ts", "src/verify.ts", "src/docs.ts", "src/instance.ts", "src/node/main.ts", "node_modules"]
}
