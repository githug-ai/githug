# Required — your OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# Optional — which model to route to. Must support tool/function calling.
# Examples: openai/gpt-4o-mini, anthropic/claude-sonnet-4.5,
#           google/gemini-2.0-flash-001, deepseek/deepseek-chat,
#           meta-llama/llama-3.3-70b-instruct
# Browse all at https://openrouter.ai/models  (default: openai/gpt-4o-mini)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional — a Hugging Face token raises HF rate limits and reaches gated model
# metadata. https://huggingface.co/settings/tokens (a read token is enough)
HF_TOKEN=

# Optional but recommended — a GitHub token raises the API rate limit
# from 60 req/hr (unauthenticated) to 5,000 req/hr. A fine-grained token with
# public read access is enough. https://github.com/settings/tokens
GITHUB_TOKEN=

# Admin login for the /stats dashboard (HTTP Basic Auth). REQUIRED to view stats —
# if unset, /stats is locked (deny-by-default). Set both to enable.
STATS_USER=admin
STATS_PASSWORD=

# Optional — cost controls
# Answer cache time-to-live (ms) and max entries. Default 24h / 2000.
CACHE_TTL_MS=86400000
CACHE_MAX=2000
# Per-IP rate limit for /api/ask: max requests per window (ms). Default 20 / 10min.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=600000

# Optional — port for the web server (default 8787; avoid 3000, Grafana uses it)
PORT=8787
